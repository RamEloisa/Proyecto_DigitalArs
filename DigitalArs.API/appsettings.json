{
  "ConnectionStrings": {
      "DefaultConnection": "Server=localhost,1433;Database=DigitalArs;Trusted_Connection=True;TrustServerCertificate=True;"
    },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": { // comprobar key guardada en user secrets: dotnet user-secrets list --project .\DigitalArs.API
    "Issuer": "DigitalArs.API",
    "Audience": "DigitalArs.Client",
    "ExpirationInMinutes": 60
  },
  "AllowedHosts": "*"
}
